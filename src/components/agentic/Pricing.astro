---
import Eyebrow from "./Eyebrow.astro";

const perAgent = [
  { tag: "Starter",  title: "Task agent",         price: "$49",  unit: "/agent/mo", desc: "Single-purpose, deterministic. 1-3 tool calls per run.",
    rows: [["Tokens / run","~3,500"],["Runs / month","500-1,000"],["Token budget","5M"]], hi: false, flag: null },
  { tag: "Standard", title: "Reasoning agent",    price: "$149", unit: "/agent/mo", desc: "Multi-step, branching logic, tool chaining. E.g. sales qualification.",
    rows: [["Tokens / run","~10,000"],["Runs / month","200-500"],["Token budget","15M"]], hi: true, flag: "Typical" },
  { tag: "Intensive",title: "Orchestrator agent", price: "$349", unit: "/agent/mo", desc: "Planning, parallel sub-agents, long context. E.g. project coordinator.",
    rows: [["Tokens / run","~45,000"],["Runs / month","50-200"],["Token budget","50M"]], hi: false, flag: null },
];

const monthly = [
  { tag: "Community", price: "$490",   unit: "/mo", desc: "Hosted community edition. Ideal for pilots and proof-of-concept.",
    rows: [["Agents included","3"],["Tools included","6"],["Runs / agent","4 / hour"],["Support","Email"],["SLA","99.5%"]], hi: false, flag: null },
  { tag: "Advanced",  price: "$1,490", unit: "/mo", desc: "Full-featured. Priority support, advanced orchestration, observability.",
    rows: [["Agents included","6"],["Tools included","12"],["Runs / agent","Unlimited"],["Support","Priority"],["SLA","99.9%"]], hi: true, flag: "Most popular" },
  { tag: "Enterprise",price: "Custom", unit: "",    desc: "Self-hosted or hybrid. Your infrastructure, your data, your LLMs.",
    rows: [["Agents","Unlimited"],["Self-hosted LLMs","Included"],["Air-gapped deploy","Available"],["SSO / SCIM","Included"],["SLA","Negotiated"]], hi: false, flag: null },
];
---
<section id="pricing" class="section" style="background:#F6F7FB">
  <div class="container">
    <div class="section-head">
      <div>
        <Eyebrow>Pricing</Eyebrow>
        <h2 class="h-section" style="margin-top:14px">Pay for complexity, not chatter.</h2>
      </div>
      <p class="lede">A flat monthly platform fee covers hosting, updates, security, and SLA. Each agent is priced by complexity tier, not per message, not per run.</p>
    </div>

    <div class="grid grid-3" style="margin-bottom:56px">
      <div class="card">
        <span style="font-size:11px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--wc-teal-500)">No infra overhead</span>
        <p class="card-body" style="margin-top:8px">Hosting, updates, security patches, and SLA covered by the platform fee. Your team focuses on the work, not the plumbing.</p>
      </div>
      <div class="card soft">
        <span style="font-size:11px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--wc-indigo-700)">Complexity-based</span>
        <p class="card-body" style="margin-top:8px">Priced by agent complexity, not raw volume. A task agent costs a fraction of an orchestrator.</p>
      </div>
      <div class="card">
        <span style="font-size:11px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--wc-teal-500)">Scales with you</span>
        <p class="card-body" style="margin-top:8px">Start with a pilot, launch a production fleet, expand agent by agent. No renegotiation needed.</p>
      </div>
    </div>

    <h3 style="font-family:Sora, sans-serif;font-weight:600;font-size:18px;letter-spacing:-.005em;margin-bottom:4px">Per-agent usage.</h3>
    <p style="font-size:14px;color:var(--wc-fg-3);margin-bottom:20px">Pick a tier per agent. Token budgets included; overage rates apply beyond.</p>
    <div class="grid grid-3" style="margin-bottom:48px">
      {perAgent.map(t => (
        <div class={"tier" + (t.hi ? " hi" : "")}>
          {t.flag && <span class="tier-flag">{t.flag}</span>}
          <span class="tier-tag">{t.tag}</span>
          <div style="font-family:Sora, sans-serif;font-weight:800;font-size:20px;letter-spacing:-.01em;margin-top:4px">{t.title}</div>
          <div class="tier-price">{t.price}<small>{t.unit}</small></div>
          <p class="tier-desc">{t.desc}</p>
          <div class="tier-rows">
            {t.rows.map(r => (
              <div class="tier-row"><span>{r[0]}</span><span class="v">{r[1]}</span></div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <h3 style="font-family:Sora, sans-serif;font-weight:600;font-size:18px;letter-spacing:-.005em;margin-bottom:4px">Monthly platform.</h3>
    <p style="font-size:14px;color:var(--wc-fg-3);margin-bottom:20px">Flat monthly fee covering hosting, security updates, maintenance, and SLA.</p>
    <div class="grid grid-3" style="margin-bottom:24px">
      {monthly.map(t => (
        <div class={"tier" + (t.hi ? " hi" : "")}>
          {t.flag && <span class="tier-flag">{t.flag}</span>}
          <span class="tier-tag">{t.tag}</span>
          <div class="tier-price">{t.price}{t.unit && <small>{t.unit}</small>}</div>
          <p class="tier-desc">{t.desc}</p>
          <div class="tier-rows">
            {t.rows.map(r => (
              <div class="tier-row"><span>{r[0]}</span><span class="v">{r[1]}</span></div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="note">
      <b>Yearly billing:</b> 15% discount when billed annually. &nbsp;·&nbsp; <b>Additional tools:</b> $50 / tool / mo beyond plan allocation.
    </div>

    <div style="margin-top:56px">
      <h3 style="font-family:Sora, sans-serif;font-weight:600;font-size:18px;letter-spacing:-.005em;margin-bottom:4px">Getting started.</h3>
      <p style="font-size:14px;color:var(--wc-fg-3);margin-bottom:20px">One-time implementation. We build, integrate, and hand over a production-ready fleet.</p>
      <div class="grid grid-3">
        <div class="card">
          <span style="font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--wc-fg-3)">Free trial</span>
          <div style="font-family:Sora, sans-serif;font-weight:800;font-size:36px;letter-spacing:-.04em;margin-top:8px">$0<small style="font-family:var(--wc-font-sans);font-weight:400;font-size:14px;color:var(--wc-fg-3);margin-left:4px">· 30 days</small></div>
          <p class="card-body" style="margin-top:8px">Validate your use case. No credit card required.</p>
        </div>
        <div class="card hi">
          <span class="card-flag">Recommended</span>
          <span style="font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--wc-indigo-700)">Pilot</span>
          <div style="font-family:Sora, sans-serif;font-weight:800;font-size:36px;letter-spacing:-.04em;margin-top:8px">$20,000<small style="font-family:var(--wc-font-sans);font-weight:400;font-size:14px;color:var(--wc-fg-3);margin-left:4px">one-time</small></div>
          <p class="card-body" style="margin-top:8px">3 custom agents, 6 tools, built, integrated, production-ready.</p>
        </div>
        <div class="card">
          <span style="font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--wc-fg-3)">Scale</span>
          <div style="font-family:Sora, sans-serif;font-weight:800;font-size:36px;letter-spacing:-.04em;margin-top:8px">$50,000+<small style="font-family:var(--wc-font-sans);font-weight:400;font-size:14px;color:var(--wc-fg-3);margin-left:4px">one-time</small></div>
          <p class="card-body" style="margin-top:8px">Larger fleet, multi-system integrations, dedicated PM.</p>
        </div>
      </div>
    </div>
  </div>
</section>
