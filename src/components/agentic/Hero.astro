---
import Eyebrow from "./Eyebrow.astro";
import Arrow from "./Arrow.astro";
---
<section id="top" style="position:relative;color:#fff;overflow:hidden;background:#110049">
  <div style="position:absolute;inset:0;background:
    radial-gradient(900px 600px at 18% 22%, rgba(91,109,238,.42) 0%, transparent 55%),
    radial-gradient(700px 500px at 88% 78%, rgba(32,187,190,.36) 0%, transparent 60%),
    radial-gradient(500px 380px at 60% 10%, rgba(126,232,212,.16) 0%, transparent 60%);"></div>
  <div style="position:absolute;inset:0;background:url('/agentic/assets/blue-wave-dots.jpeg') center/cover no-repeat;opacity:.28;mix-blend-mode:screen"></div>

  <div class="container" style="position:relative;padding:112px 32px 96px;max-width:1180px;margin:0 auto">
    <Eyebrow onDark>Agentic AI Platform</Eyebrow>
    <h1 class="h-display" style="color:#fff;margin-top:20px;max-width:980px">
      Ship a fleet of <span class="grad">AI agents</span><br/>
      without renting <span style="font-weight:300;color:rgba(255,255,255,.5)">or reinventing</span> your stack.
    </h1>
    <p class="lede on-dark" style="margin-top:22px;max-width:620px">
      A new AI era is here, one where software doesn't just answer, it acts. Put autonomous agents into production fast, with the controls, observability and exit-options that enterprise teams require.
    </p>

    <div class="hero-cta-panel" style="
      margin-top:48px;display:grid;
      grid-template-columns:minmax(0,1.35fr) minmax(0,1fr);
      align-items:stretch;border-radius:18px;
      background:linear-gradient(135deg, rgba(91,109,238,.18) 0%, rgba(32,187,190,.14) 100%);
      border:1px solid rgba(126,232,212,.22);overflow:hidden;
      backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);">
      <div style="padding:26px 30px;display:flex;flex-direction:column;justify-content:center;gap:8px">
        <div style="font-size:11px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:#7EE8D4">The challenge</div>
        <p style="margin:0;font-family:Sora,sans-serif;font-weight:500;font-size:clamp(16px,1.45vw,19px);line-height:1.4;color:#fff;letter-spacing:-.005em">
          We know where the AI era is going. The real work is <span style="color:#7EE8D4;font-weight:600">controlling the journey</span>, capturing the upside without falling into the risk.
        </p>
      </div>
      <div class="hero-cta-actions" style="
        padding:26px 30px;background:rgba(17,0,73,.35);
        border-left:1px solid rgba(126,232,212,.18);
        display:flex;flex-direction:column;gap:10px;justify-content:center">
        <a href="#contact" class="btn btn-light" style="justify-content:space-between">
          <span>Talk to us</span> <Arrow />
        </a>
        <a href="#our-way" class="btn btn-ghost-dark" style="justify-content:space-between">
          <span>See our approach</span> <Arrow />
        </a>
      </div>
    </div>
  </div>
</section>
