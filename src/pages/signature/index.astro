---
import signatureTemplate from "../../data/signature-template.html?raw";
import { buildPreviewDocument, buildSignatureHtml, defaultSignatureFields } from "../../lib/signature";

const initialSignatureHtml = buildSignatureHtml(signatureTemplate, defaultSignatureFields);
const initialPreviewLight = buildPreviewDocument(initialSignatureHtml, "light");
const initialPreviewDark = buildPreviewDocument(initialSignatureHtml, "dark");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>weCan Signature Generator</title>
    <meta name="description" content="Internal weCan email signature generator." />
    <meta name="robots" content="noindex, nofollow" />
    <style>
      :root {
        --page-bg: #f4f7f5;
        --panel-bg: #ffffff;
        --panel-border: rgba(17, 31, 28, 0.08);
        --text-1: #162320;
        --text-2: #5f6e69;
        --accent: #1d9e75;
        --accent-dark: #157659;
        --shadow: 0 20px 60px rgba(15, 35, 29, 0.08);
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
        color: var(--text-1);
        background:
          radial-gradient(circle at top left, rgba(29, 158, 117, 0.12), transparent 28%),
          radial-gradient(circle at bottom right, rgba(17, 31, 28, 0.08), transparent 32%),
          var(--page-bg);
      }

      body {
        min-height: 100vh;
      }

      .page {
        width: min(1180px, calc(100vw - 32px));
        margin: 0 auto;
        padding: 32px 0 48px;
      }

      .header {
        margin-bottom: 24px;
      }

      .eyebrow {
        margin: 0 0 8px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--accent);
      }

      h1 {
        margin: 0;
        font-size: clamp(32px, 4vw, 52px);
        line-height: 1.05;
        letter-spacing: -0.04em;
      }

      .lede {
        max-width: 760px;
        margin: 12px 0 0;
        font-size: 16px;
        line-height: 1.6;
        color: var(--text-2);
      }

      .notice {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin-top: 16px;
        padding: 10px 14px;
        border: 1px solid rgba(29, 158, 117, 0.18);
        border-radius: 999px;
        background: rgba(29, 158, 117, 0.08);
        color: var(--accent-dark);
        font-size: 13px;
        font-weight: 600;
      }

      .layout {
        display: grid;
        grid-template-columns: minmax(320px, 420px) minmax(0, 1fr);
        gap: 24px;
        align-items: start;
      }

      .panel {
        background: var(--panel-bg);
        border: 1px solid var(--panel-border);
        border-radius: 24px;
        box-shadow: var(--shadow);
      }

      .form-panel {
        padding: 24px;
        position: sticky;
        top: 24px;
      }

      .panel-title {
        margin: 0 0 6px;
        font-size: 18px;
        font-weight: 700;
        letter-spacing: -0.02em;
      }

      .panel-copy {
        margin: 0 0 20px;
        font-size: 14px;
        line-height: 1.6;
        color: var(--text-2);
      }

      .field {
        display: grid;
        gap: 8px;
        margin-bottom: 16px;
      }

      .field label {
        font-size: 13px;
        font-weight: 700;
        color: var(--text-1);
      }

      .field input {
        width: 100%;
        border: 1px solid rgba(22, 35, 32, 0.14);
        border-radius: 14px;
        padding: 14px 16px;
        font: inherit;
        color: var(--text-1);
        background: #fff;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
      }

      .field input:focus {
        outline: none;
        border-color: rgba(29, 158, 117, 0.6);
        box-shadow: 0 0 0 4px rgba(29, 158, 117, 0.12);
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 20px;
      }

      .button {
        appearance: none;
        border: 0;
        border-radius: 14px;
        padding: 13px 16px;
        font: inherit;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
      }

      .button-primary {
        background: var(--accent);
        color: #fff;
      }

      .button-primary:hover {
        background: var(--accent-dark);
      }

      .button-secondary {
        background: rgba(22, 35, 32, 0.06);
        color: var(--text-1);
      }

      .status {
        min-height: 20px;
        margin-top: 14px;
        font-size: 13px;
        font-weight: 600;
        color: var(--accent-dark);
      }

      .preview-panel {
        padding: 24px;
      }

      .previews {
        display: grid;
        gap: 14px;
      }

      .preview-shell {
        position: relative;
        padding: 34px 24px 20px;
        border: 1px solid rgba(22, 35, 32, 0.08);
        border-radius: 18px;
        background: #ffffff;
      }

      .preview-shell-dark {
        border-color: rgba(255, 255, 255, 0.14);
        background: #1e1e1e;
      }

      .preview-label {
        position: absolute;
        top: 12px;
        left: 24px;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--text-2);
      }

      .preview-shell-dark .preview-label {
        color: #7d8a86;
      }

      .preview-shell iframe {
        display: block;
        width: 100%;
        min-height: 165px;
        border: 0;
        background: transparent;
      }

      .preview-hints {
        margin-top: 18px;
        font-size: 13px;
        line-height: 1.7;
        color: var(--text-2);
      }

      .preview-hints h2 {
        margin: 0 0 6px;
        font-size: 14px;
        font-weight: 700;
        color: var(--text-1);
      }

      .preview-hints p {
        margin: 0 0 8px;
      }

      .preview-hints ul {
        margin: 0;
        padding-left: 20px;
      }

      .preview-hints strong {
        color: var(--text-1);
      }

      .preview-hints code {
        font: 12px/1 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        padding: 2px 5px;
        border-radius: 6px;
        background: rgba(22, 35, 32, 0.06);
      }

      .hint-note {
        margin: 12px 0 0;
      }

      .instructions {
        margin-top: 22px;
      }

      .instructions h2 {
        margin: 0 0 8px;
        font-size: 16px;
        font-weight: 700;
        letter-spacing: -0.01em;
      }

      .instructions-lede {
        margin: 0 0 18px;
        font-size: 14px;
        line-height: 1.6;
        color: var(--text-2);
      }

      .variant {
        margin-bottom: 16px;
      }

      .variant h3,
      .check h3 {
        margin: 0 0 6px;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.02em;
      }

      .instructions ol,
      .instructions ul {
        margin: 0;
        padding-left: 20px;
        font-size: 13px;
        line-height: 1.7;
        color: var(--text-2);
      }

      .instructions strong {
        color: var(--text-1);
      }

      .check {
        margin-top: 20px;
        padding: 16px 18px;
        border: 1px solid rgba(29, 158, 117, 0.18);
        border-radius: 16px;
        background: rgba(29, 158, 117, 0.06);
      }

      .check p {
        margin: 0 0 8px;
        font-size: 13px;
        line-height: 1.7;
        color: var(--text-2);
      }

      .check .warn {
        margin: 12px 0 0;
        padding-top: 12px;
        border-top: 1px solid rgba(29, 158, 117, 0.18);
      }

      .output {
        margin-top: 22px;
        padding-top: 18px;
        border-top: 1px solid rgba(22, 35, 32, 0.08);
      }

      .output summary {
        cursor: pointer;
        font-size: 13px;
        font-weight: 700;
        color: var(--text-2);
      }

      .output-note {
        margin: 10px 0;
        font-size: 13px;
        line-height: 1.6;
        color: var(--text-2);
      }

      .output .button {
        margin-top: 10px;
      }

      textarea {
        width: 100%;
        min-height: 320px;
        resize: vertical;
        border: 1px solid rgba(22, 35, 32, 0.1);
        border-radius: 16px;
        background: #0f1413;
        color: #dce7e3;
        font: 12px/1.5 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        padding: 16px;
      }

      .help {
        margin-top: 14px;
        font-size: 13px;
        line-height: 1.6;
        color: var(--text-2);
      }

      .help strong {
        color: var(--text-1);
      }

      @media (max-width: 920px) {
        .layout {
          grid-template-columns: 1fr;
        }

        .form-panel {
          position: static;
        }

        .page {
          width: min(100vw - 24px, 1180px);
          padding-top: 24px;
        }
      }
    </style>
  </head>
  <body>
    <main class="page">
      <header class="header">
        <h1>weCan signature generator</h1>
      </header>

      <section class="layout">
        <aside class="panel form-panel">
          <h2 class="panel-title">Signature details</h2>
          <p class="panel-copy">The preview and source HTML update as you type.</p>

          <div class="field">
            <label for="sig-name">Name</label>
            <input id="sig-name" name="name" type="text" placeholder="John Doe" value={defaultSignatureFields.name} />
          </div>

          <div class="field">
            <label for="sig-title">Title</label>
            <input id="sig-title" name="title" type="text" placeholder="Sample Title" value={defaultSignatureFields.title} />
          </div>

          <div class="field">
            <label for="sig-phone">Phone number</label>
            <input id="sig-phone" name="phone" type="text" placeholder="+36 30 123 4567" value={defaultSignatureFields.phone} />
          </div>

          <div class="actions">
            <button class="button button-primary" type="button" id="copy-rich">Copy signature</button>
          </div>

          <div class="status" id="copy-status" aria-live="polite"></div>
        </aside>

        <section class="panel preview-panel">
          <div class="previews">
            <div class="preview-shell">
              <span class="preview-label">Light mode</span>
              <iframe
                id="signature-preview-light"
                title="Signature preview, light mode"
                srcdoc={initialPreviewLight}></iframe>
            </div>

            <div class="preview-shell preview-shell-dark">
              <span class="preview-label">Dark mode</span>
              <iframe
                id="signature-preview-dark"
                title="Signature preview, dark mode"
                srcdoc={initialPreviewDark}></iframe>
            </div>
          </div>

          <div class="preview-hints">
            <h2>Reading the two previews</h2>
            <p>
              Both are shown at once on purpose — you can't judge dark mode by switching your
              own machine over, because most Outlook variants can't run the swap at all.
              Compare the panes against this:
            </p>
            <ul>
              <li><strong>Light:</strong> near-black name, mid-grey mark, green rule.</li>
              <li><strong>Dark:</strong> near-white name, pale mark, same green rule.</li>
              <li><strong>Each pane shows exactly one mark.</strong> Two stacked marks in either pane means the swap broke.</li>
            </ul>
            <p class="hint-note">
              The dark pane is what clients supporting <code>prefers-color-scheme</code> render.
              Where that isn't supported — including classic Outlook on Windows — you get the
              light version, which is the intended fallback, not a fault.
            </p>
          </div>

          <div class="instructions">
            <h2>How to insert it</h2>
            <p class="instructions-lede">
              Click <strong>Copy signature</strong>, then follow the steps for your Outlook.
              Paste with plain <strong>Ctrl+V</strong> (<strong>⌘V</strong> on Mac) —
              never Ctrl+Shift+V, and never “Keep Text Only”.
            </p>

            <div class="variant">
              <h3>Classic Outlook (Windows desktop)</h3>
              <ol>
                <li>File → Options → Mail → Signatures…</li>
                <li>Pick your signature, or click New.</li>
                <li>Click inside the large edit box, then Ctrl+V.</li>
                <li>OK, then close and reopen Outlook once.</li>
              </ol>
            </div>

            <div class="variant">
              <h3>New Outlook / Outlook on the web</h3>
              <ol>
                <li>Settings (gear icon) → Accounts → Signatures.</li>
                <li>Click inside the signature box, then Ctrl+V.</li>
                <li>Save.</li>
              </ol>
            </div>

            <div class="variant">
              <h3>Outlook for Mac</h3>
              <ol>
                <li>Outlook → Settings → Signatures.</li>
                <li>Click +, or double-click an existing signature.</li>
                <li>Click inside the edit area, then ⌘V.</li>
                <li>Close the window to save.</li>
              </ol>
            </div>

            <div class="check">
              <h3>Check it worked</h3>
              <p>Send yourself a test email, then confirm all three:</p>
              <ul>
                <li>You can <strong>select the text</strong> with your cursor. If you can't, it's an image — delete it and start over.</li>
                <li>There is <strong>exactly one logo mark</strong>, not two.</li>
                <li>The <strong>phone number is a link</strong> you can click.</li>
              </ul>
              <p class="warn">
                Never take a screenshot of the preview and paste that in. An image signature
                is unreadable to screen readers, blurry on other screens, gets blocked as a
                remote image, and makes your phone number and website unclickable.
              </p>
            </div>
          </div>

          <details class="output">
            <summary>Advanced: signature source HTML</summary>
            <p class="output-note">
              Only needed if your mail tool accepts raw HTML directly. For Outlook, use the
              Copy signature button above instead.
            </p>
            <textarea id="signature-html" spellcheck="false">{initialSignatureHtml}</textarea>
            <button class="button button-secondary" type="button" id="copy-html">Copy source HTML</button>
          </details>
        </section>
      </section>
    </main>

    <script>
      import { setupSignaturePage } from "../../scripts/signature-page";

      setupSignaturePage();
    </script>
  </body>
</html>