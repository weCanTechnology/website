---
import signatureTemplate from "../../data/signature-template.html?raw";
import { buildSignatureHtml, defaultSignatureFields } from "../../lib/signature";

const initialSignatureHtml = buildSignatureHtml(signatureTemplate, defaultSignatureFields);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>weCan Signature Generator</title>
    <meta name="description" content="Internal weCan email signature generator." />
    <meta name="robots" content="noindex, nofollow" />
    <style>
      :root {
        --page-bg: #f4f7f5;
        --panel-bg: #ffffff;
        --panel-border: rgba(17, 31, 28, 0.08);
        --text-1: #162320;
        --text-2: #5f6e69;
        --accent: #1d9e75;
        --accent-dark: #157659;
        --shadow: 0 20px 60px rgba(15, 35, 29, 0.08);
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
        color: var(--text-1);
        background:
          radial-gradient(circle at top left, rgba(29, 158, 117, 0.12), transparent 28%),
          radial-gradient(circle at bottom right, rgba(17, 31, 28, 0.08), transparent 32%),
          var(--page-bg);
      }

      body {
        min-height: 100vh;
      }

      .page {
        width: min(1180px, calc(100vw - 32px));
        margin: 0 auto;
        padding: 32px 0 48px;
      }

      .header {
        margin-bottom: 24px;
      }

      .eyebrow {
        margin: 0 0 8px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--accent);
      }

      h1 {
        margin: 0;
        font-size: clamp(32px, 4vw, 52px);
        line-height: 1.05;
        letter-spacing: -0.04em;
      }

      .lede {
        max-width: 760px;
        margin: 12px 0 0;
        font-size: 16px;
        line-height: 1.6;
        color: var(--text-2);
      }

      .notice {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin-top: 16px;
        padding: 10px 14px;
        border: 1px solid rgba(29, 158, 117, 0.18);
        border-radius: 999px;
        background: rgba(29, 158, 117, 0.08);
        color: var(--accent-dark);
        font-size: 13px;
        font-weight: 600;
      }

      .layout {
        display: grid;
        grid-template-columns: minmax(320px, 420px) minmax(0, 1fr);
        gap: 24px;
        align-items: start;
      }

      .panel {
        background: var(--panel-bg);
        border: 1px solid var(--panel-border);
        border-radius: 24px;
        box-shadow: var(--shadow);
      }

      .form-panel {
        padding: 24px;
        position: sticky;
        top: 24px;
      }

      .panel-title {
        margin: 0 0 6px;
        font-size: 18px;
        font-weight: 700;
        letter-spacing: -0.02em;
      }

      .panel-copy {
        margin: 0 0 20px;
        font-size: 14px;
        line-height: 1.6;
        color: var(--text-2);
      }

      .field {
        display: grid;
        gap: 8px;
        margin-bottom: 16px;
      }

      .field label {
        font-size: 13px;
        font-weight: 700;
        color: var(--text-1);
      }

      .field input {
        width: 100%;
        border: 1px solid rgba(22, 35, 32, 0.14);
        border-radius: 14px;
        padding: 14px 16px;
        font: inherit;
        color: var(--text-1);
        background: #fff;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
      }

      .field input:focus {
        outline: none;
        border-color: rgba(29, 158, 117, 0.6);
        box-shadow: 0 0 0 4px rgba(29, 158, 117, 0.12);
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 20px;
      }

      .button {
        appearance: none;
        border: 0;
        border-radius: 14px;
        padding: 13px 16px;
        font: inherit;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
      }

      .button-primary {
        background: var(--accent);
        color: #fff;
      }

      .button-primary:hover {
        background: var(--accent-dark);
      }

      .button-secondary {
        background: rgba(22, 35, 32, 0.06);
        color: var(--text-1);
      }

      .status {
        min-height: 20px;
        margin-top: 14px;
        font-size: 13px;
        font-weight: 600;
        color: var(--accent-dark);
      }

      .preview-panel {
        padding: 24px;
      }

      .preview-shell {
        padding: 24px;
        border: 1px solid rgba(22, 35, 32, 0.08);
        border-radius: 18px;
        background: linear-gradient(180deg, #ffffff 0%, #fbfdfc 100%);
      }

      .preview-shell iframe {
        width: 100%;
        min-height: 230px;
        border: 0;
        background: transparent;
      }

      .output {
        margin-top: 18px;
      }

      .output-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 10px;
      }

      .output-header h2 {
        margin: 0;
        font-size: 15px;
        font-weight: 700;
      }

      .output-header p {
        margin: 0;
        font-size: 13px;
        color: var(--text-2);
      }

      textarea {
        width: 100%;
        min-height: 320px;
        resize: vertical;
        border: 1px solid rgba(22, 35, 32, 0.1);
        border-radius: 16px;
        background: #0f1413;
        color: #dce7e3;
        font: 12px/1.5 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        padding: 16px;
      }

      .help {
        margin-top: 14px;
        font-size: 13px;
        line-height: 1.6;
        color: var(--text-2);
      }

      .help strong {
        color: var(--text-1);
      }

      @media (max-width: 920px) {
        .layout {
          grid-template-columns: 1fr;
        }

        .form-panel {
          position: static;
        }

        .page {
          width: min(100vw - 24px, 1180px);
          padding-top: 24px;
        }
      }
    </style>
  </head>
  <body>
    <main class="page">
      <header class="header">
        <h1>weCan signature generator</h1>
      </header>

      <section class="layout">
        <aside class="panel form-panel">
          <h2 class="panel-title">Signature details</h2>
          <p class="panel-copy">The preview and source HTML update as you type.</p>

          <div class="field">
            <label for="sig-name">Name</label>
            <input id="sig-name" name="name" type="text" placeholder="John Doe" value={defaultSignatureFields.name} />
          </div>

          <div class="field">
            <label for="sig-title">Title</label>
            <input id="sig-title" name="title" type="text" placeholder="Sample Title" value={defaultSignatureFields.title} />
          </div>

          <div class="field">
            <label for="sig-phone">Phone number</label>
            <input id="sig-phone" name="phone" type="text" placeholder="+36 30 123 4567" value={defaultSignatureFields.phone} />
          </div>

          <div class="actions">
            <button class="button button-primary" type="button" id="copy-html">Copy source HTML</button>
            <button class="button button-secondary" type="button" id="copy-rich">Copy rendered signature</button>
          </div>

          <div class="status" id="copy-status" aria-live="polite"></div>

          <p class="help">
            <strong>Recommended use:</strong> copy the rendered signature for rich email clients,
            or copy the source HTML if your mail app accepts direct HTML input.
          </p>
        </aside>

        <section class="panel preview-panel">
          <div class="preview-shell">
            <iframe id="signature-preview" title="Signature preview" srcdoc={initialSignatureHtml}></iframe>
          </div>

          <div class="output">
            <div class="output-header">
              <div>
                <h2>Generated HTML</h2>
                <p>Use this source if you need the raw signature markup.</p>
              </div>
            </div>
            <textarea id="signature-html" spellcheck="false">{initialSignatureHtml}</textarea>
          </div>
        </section>
      </section>
    </main>

    <script>
      import { setupSignaturePage } from "../../scripts/signature-page";

      setupSignaturePage();
    </script>
  </body>
</html>